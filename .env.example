# ---------------------------------------------------------------
# Copia este archivo a .env.local y rellena lo que haga falta.
# Ninguna variable lleva prefijo NEXT_PUBLIC_: todas se leen solo en
# el servidor y no deben acabar en el bundle del navegador.
# ---------------------------------------------------------------

# --- LECTURA DE DRC GESTIÓN (obligatorias) ---
# Sin ellas no hay alumnos ni fichas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- BASE PROPIA DEL LMS ---
# OTRO proyecto de Supabase, distinto del de Gestión. Las lee
# lib/supabase-lms.ts, que es el único módulo que escribe.
#
# La URL va sin path: solo https://<ref>.supabase.co. Si le dejas el
# /rest/v1/ que aparece en el panel, supabase-js lo concatena al suyo y
# todo responde PGRST125 "Invalid path specified in request URL", que
# parece un fallo de conexión y no lo es.
#
# Las dos claves NO son intercambiables con las de Gestión: pertenecen a
# proyectos distintos y cruzarlas devuelve 401 en cada petición.
LMS_SUPABASE_URL=
LMS_SUPABASE_SERVICE_KEY=

# --- ACCESO POR MAGIC LINK (obligatorias) ---

# Clave con la que se firman los enlaces del email y las cookies de
# sesión. Mínimo 32 caracteres aleatorios; genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si cambia, todas las sesiones abiertas dejan de valer.
SECRETO_SESION=

# Clave de Resend para enviar el enlace de acceso.
RESEND_API_KEY=

# Emails del equipo, separados por comas. Estos conservan la home con
# el buscador y pueden abrir cualquier ficha. No hace falta que estén
# en vista_perfil_alumno.
#
# OJO al cargarla en Vercel: aquí dotenv quita las comillas, pero en el
# panel de Vercel pasarían a formar parte del valor y no coincidiría
# ningún admin. Pega el valor sin comillas.
#   EMAILS_ADMIN=alguien@drcacademy.com,otro@drcacademy.com
EMAILS_ADMIN=

# --- ENTRADA DESDE WOOCOMMERCE (opcional) ---

# Clave con la que WordPress firma el sobre del botón. DISTINTA de
# SECRETO_SESION a propósito: esta vive también en drcacademy.com, y si
# fuera la misma, un WordPress comprometido podría fabricar cookies de
# administrador. Con ella separada, lo más que se consigue desde allí
# es abrir sesión de alumno.
#
# El mismo valor va en el wp-config.php del WordPress:
#   define( 'DRC_SECRETO_WOO', '…' );
#
# Sin ella el LMS funciona igual; solo deja de andar el botón.
SECRETO_WOO=

# --- CONSULTAS DESDE DRC GESTIÓN (opcional) ---

# Secreto compartido de /api/externo/*, que Gestión llama de servidor a
# servidor con la cabecera `x-gestion-secret`. Hoy es una sola ruta:
# el estado del diploma de un alumno, para su ficha de progreso.
#
# DISTINTO de los otros dos secretos, por lo mismo que SECRETO_WOO: este
# vive también en el proyecto de Gestión, y lo más que abre es una
# lectura. Mínimo 32 caracteres aleatorios; genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# El mismo valor va en las variables de entorno de Gestión (en Vercel,
# Production y Preview), con el nombre que se le dé allí.
#
# Sin ella, las rutas de /api/externo responden 503 y no dejan pasar a
# nadie: el LMS funciona igual y Gestión no ve el diploma.
SECRETO_GESTION=

# --- RECUPERACIONES DE CLASES CANCELADAS (LLAMADAS A DRC GESTIÓN) ---

# La dirección contraria: el LMS llama a la API de Gestión
# (/api/lms/recuperaciones) de servidor a servidor, con la cabecera
# `x-lms-secret`. Ver lib/gestion-api.ts (lo usan las recuperaciones y
# el autoservicio de horarios).
#
# GESTION_URL es la dirección PÚBLICA de Gestión, nunca la de un
# despliegue concreto de Vercel (esas están protegidas y responden 401).
#   GESTION_URL=https://academy-scheduler-aqpt.vercel.app
#
# LMS_GESTION_SECRET lleva el MISMO valor que la variable del mismo
# nombre en Gestión. Es DISTINTO de SECRETO_GESTION: cada sentido tiene
# su secreto.
#
# Sin ellas, «Mis clases» dice que no puede cargar las recuperaciones y
# el resto del LMS funciona igual.
GESTION_URL=
LMS_GESTION_SECRET=

# --- AUTOSERVICIO DE HORARIOS EN «MIS CLASES» (lib/autoservicio/) ---
#
# AUTOSERVICIO_ACTIVO=1 enseña «Cambiar de horario». Necesita
# GESTION_URL y LMS_GESTION_SECRET (las de arriba). Vacía o con
# cualquier otro valor, «Mis clases» se ve como siempre. Por defecto,
# apagado.
#
# AUTOSERVICIO_SIMULADO usa datos inventados en vez de Gestión, para
# probar las pantallas sin tocar ningún calendario. «1» es el caso
# normal; NO_ELEGIBLE, RECUPERACION_PENDIENTE, CALENDARIO_SIN_ACTUALIZAR
# o ERROR_LECTURA, un alumno que no puede cambiar nada. Solo con ella
# sale «Cambiar de profesor» (fase 2). En producción (VERCEL_ENV) se
# ignora siempre. No la pongas en Vercel.
#
# AUTOSERVICIO_ALUMNOS_PRUEBA: `alumno_id` (students.id de Gestión)
# separados por comas. Con AUTOSERVICIO_ACTIVO apagado, solo ellos ven
# «Tu horario». Para probarlo en producción con cuentas de prueba antes
# de abrirlo a todos.
#   AUTOSERVICIO_ALUMNOS_PRUEBA=s_1785241971018,s_1784255748665
AUTOSERVICIO_ACTIVO=
AUTOSERVICIO_SIMULADO=
AUTOSERVICIO_ALUMNOS_PRUEBA=

# --- OPCIONALES ---

# OBLIGATORIA, aunque esté debajo de «opcionales»: sin ella no sale
# ningún correo. Es la dirección pública del LMS con la que se montan
# los enlaces de los correos (acceso, avisos, baja). Solo el origen, sin
# barra ni ruta. La lee únicamente `lib/url-publica.ts`, y si falta o
# está mal escrita lanza error: no hay alternativa por defecto, y
# VERCEL_URL no se usa nunca (es el despliegue concreto, no producción).
#
# Hoy, el dominio del proyecto de Vercel `drc-lms` (no `lms-drc`, que es
# el nombre del repo):
#   URL_BASE=https://drc-lms.vercel.app
# En local:
#   URL_BASE=http://localhost:3000
#
# Cuando el LMS pase a dominio propio: .com, NO .es (drcacademy.es no
# resuelve), y cambiar a la vez DRC_LMS_URL en el plugin de WordPress.
#   URL_BASE=https://practica.drcacademy.com
URL_BASE=

# --- FORMULARIO DE PERFIL (DRC GESTIÓN) ---

# Raíz del formulario que rellena el alumno. El LMS le pega
# `/formulario/<token>`, con el token que viene de
# `vista_perfil_alumno.form_token`.
#
# EN UNA VARIABLE Y NO EN EL CÓDIGO porque hoy es un despliegue de Vercel
# y mañana puede ser un dominio propio de Gestión: ese día se cambia esto
# y no se toca el repositorio.
#
# Sin ella no hay enlace y el botón "Completar mi perfil" no se pinta.
# Es a propósito: es preferible no ofrecer nada a mandar al alumno a una
# pantalla rota. Si el botón no aparece en ningún sitio, empieza por
# mirar si esta variable está puesta.
#   URL_FORMULARIO_BASE=https://academy-scheduler-aqpt.vercel.app
URL_FORMULARIO_BASE=

# Clave de la API de Anthropic. Sin ella, /api/generar-bloque sirve
# bloques del banco de reserva (lib/banco.ts) y la demo funciona igual.
ANTHROPIC_API_KEY=

# A dónde lleva "Amplía tu plan", el botón del banner de ritmo de
# /progreso. Opcional: sin ella se usa
#   https://drcacademy.com/mi-cuenta/?drc-ampliar-plan=1
# que el snippet wordpress/drc-ampliar-plan.php convierte, en el servidor
# de WordPress, en el cambio de plan de WooCommerce Subscriptions: el
# mismo destino que tiene el botón de la ficha de DRC Gestión. SOLO
# funciona con ese snippet activo en drcacademy.com; sin él, la URL se
# queda en Mi cuenta.
#
# El banner solo aparece si `vista_perfil_alumno` trae las horas
# semanales, o sea si se corrió supabase/gestion-vista-perfil-ritmo.sql.
# Esta variable no lo enciende ni lo apaga, solo cambia el destino.
URL_AMPLIAR_PLAN=
