# ---------------------------------------------------------------
# Copia este archivo a .env.local y rellena lo que haga falta.
# Ninguna variable lleva prefijo NEXT_PUBLIC_: todas se leen solo en
# el servidor y no deben acabar en el bundle del navegador.
# ---------------------------------------------------------------

# --- LECTURA DE DRC GESTIÓN (obligatorias) ---
# Sin ellas no hay alumnos ni fichas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- ACCESO POR MAGIC LINK (obligatorias) ---

# Clave con la que se firman los enlaces del email y las cookies de
# sesión. Mínimo 32 caracteres aleatorios; genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si cambia, todas las sesiones abiertas dejan de valer.
SECRETO_SESION=

# Clave de Resend para enviar el enlace de acceso.
RESEND_API_KEY=

# Emails del equipo, separados por comas. Estos conservan la home con
# el buscador y pueden abrir cualquier ficha. No hace falta que estén
# en vista_perfil_alumno.
#
# OJO al cargarla en Vercel: aquí dotenv quita las comillas, pero en el
# panel de Vercel pasarían a formar parte del valor y no coincidiría
# ningún admin. Pega el valor sin comillas.
#   EMAILS_ADMIN=alguien@drcacademy.com,otro@drcacademy.com
EMAILS_ADMIN=

# --- ENTRADA DESDE WOOCOMMERCE (opcional) ---

# Clave con la que WordPress firma el sobre del botón. DISTINTA de
# SECRETO_SESION a propósito: esta vive también en drcacademy.com, y si
# fuera la misma, un WordPress comprometido podría fabricar cookies de
# administrador. Con ella separada, lo más que se consigue desde allí
# es abrir sesión de alumno.
#
# El mismo valor va en el wp-config.php del WordPress:
#   define( 'DRC_SECRETO_WOO', '…' );
#
# Sin ella el LMS funciona igual; solo deja de andar el botón.
SECRETO_WOO=

# --- OPCIONALES ---

# Dominio con el que se construye el enlace del email. Si no está, en
# Vercel se usa el del despliegue y en local http://localhost:3000.
# Ponla si el sitio se sirve por un dominio propio.
#   URL_BASE=https://practica.drcacademy.es
URL_BASE=

# Clave de la API de Anthropic. Sin ella, /api/generar-bloque sirve
# bloques del banco de reserva (lib/banco.ts) y la demo funciona igual.
ANTHROPIC_API_KEY=
